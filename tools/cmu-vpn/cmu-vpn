#!/bin/bash
# cmu-vpn: the CMU VPN tunnel with fixed openconnect arguments, so one sudoers rule can allow it without a
# password. Install root-owned at /usr/local/sbin/cmu-vpn (see README). The login (SSO + Duo) happens as the
# user, in cmu-vpn-up; this script only starts and stops the tunnel.
#
#   cmu-vpn connect <server-fingerprint>     session cookie on stdin (one line); returns once the tunnel is up
#   cmu-vpn disconnect
#   cmu-vpn status                           prints "connected <pid>" (exit 0) or "disconnected" (exit 1)
#
# Nothing from the caller reaches openconnect except the cookie (stdin) and a fingerprint checked against a
# strict pattern, so the rule cannot be used to pass --script or another server.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
SERVER=https://vpn.cmu.edu
VERSION=4.7.00136                 # openconnect-sso's default AnyConnect version
IFACE=cmuvpn0
PIDFILE=/run/cmu-vpn.pid

running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

case "${1:-}" in
connect)
    fp=${2:-}
    if ! [[ $fp =~ ^((pin-sha256:[A-Za-z0-9+/]{43}=)|((sha1:|sha256:)?[0-9A-Fa-f]{40})|((sha256:)?[0-9A-Fa-f]{64}))$ ]]; then
        echo "cmu-vpn: bad server fingerprint" >&2; exit 2
    fi
    if running; then echo "cmu-vpn: already connected" >&2; exit 3; fi
    IFS= read -r cookie || true
    if [ -z "${cookie:-}" ]; then echo "cmu-vpn: no cookie on stdin" >&2; exit 2; fi
    rm -f "$PIDFILE"
    printf '%s\n' "$cookie" | openconnect --useragent "AnyConnect Linux_64 $VERSION" --version-string "$VERSION" \
        --cookie-on-stdin --servercert "$fp" --interface "$IFACE" --background --pid-file "$PIDFILE" --syslog \
        --quiet "$SERVER"
    running && echo "connected $(cat "$PIDFILE")"
    ;;
disconnect)
    if running; then
        kill -INT "$(cat "$PIDFILE")"
        for _ in $(seq 20); do running || break; sleep 0.5; done
        running && kill -TERM "$(cat "$PIDFILE")"
    fi
    rm -f "$PIDFILE"
    echo disconnected
    ;;
status)
    if running; then echo "connected $(cat "$PIDFILE")"; else echo disconnected; exit 1; fi
    ;;
*)
    echo "usage: cmu-vpn connect <fingerprint> | disconnect | status" >&2; exit 2
    ;;
esac

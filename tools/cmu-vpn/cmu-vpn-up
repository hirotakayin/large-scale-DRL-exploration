#!/bin/bash
# Log in to the CMU VPN (SSO window + Duo push, as this user) and bring the tunnel up through
# `sudo -n /usr/local/sbin/cmu-vpn`. Exit 0 once connected. Safe to call from a GUI: no terminal needed.
#   cmu-vpn-up [--hidden]     --hidden only if the login page fills in the saved password by itself
set -euo pipefail
SSO=~/.venvs/cmu-vpn/bin/openconnect-sso
mode=shown
[ "${1:-}" = --hidden ] && mode=hidden
if sudo -n /usr/local/sbin/cmu-vpn status >/dev/null 2>&1; then echo "already connected"; exit 0; fi
# the blank line answers openconnect-sso's "TOTP secret" prompt: the second factor stays the Duo push
auth=$(printf '\n' | "$SSO" --server vpn.cmu.edu --user "${CMU_VPN_USER:-$USER}" --browser-display-mode "$mode" --authenticate json)
read -r fp cookie < <(printf '%s' "$auth" | python3 -c 'import json,sys; t=sys.stdin.read(); d=json.loads(t[t.index("{"):t.rindex("}") + 1]); print(d["fingerprint"], d["cookie"])')
printf '%s\n' "$cookie" | sudo -n /usr/local/sbin/cmu-vpn connect "$fp"
